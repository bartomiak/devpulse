{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & Run",
      "type": "shell",
      "command": "./run.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "./build.sh release",
      "group": "build",
      "problemMatcher": ["$swiftc"]
    }
  ]
}
